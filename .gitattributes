# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must be LF and executable on Linux (spec section 36/37).
*.sh text eol=lf
*.bash text eol=lf

# PowerShell scripts are authored on Windows and must stay readable there.
*.ps1 text eol=crlf
*.psm1 text eol=crlf

# Python and config files are LF everywhere.
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf

# Binary assets are never line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.onnx binary
*.wav binary
*.mp3 binary
