# ---------------------------------------------------------------------------
# ULTRON - .gitignore
# Secrets must never be committed (spec section 31).
# ---------------------------------------------------------------------------

# --- Secrets / local configuration -----------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
config/local/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
wheels/
share/python-wheels/
pip-wheel-metadata/

# --- Virtual environments ----------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# --- Test / coverage / caches -----------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
.cov.json
.coverage-*.json
htmlcov/
coverage.xml
.hypothesis/

# --- Type stubs / build ------------------------------------------------------
*.tsbuildinfo

# --- Editors / OS -----------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# ULTRON runtime data (spec section 47)
# ---------------------------------------------------------------------------
/data/
/logs/
/workspaces/
*.log

# --- Local services ---------------------------------------------------------
docker-compose.override.yml
.pgdata/
.redisdata/
.ollama/

# --- Playwright -------------------------------------------------------------
ms-playwright/
playwright-report/
test-results/

# --- Voice models -----------------------------------------------------------
models/whisper/
models/piper/
*.onnx
*.onnx_data

# --- Python bytecode caches inside migrations --------------------------------
migrations/__pycache__/
migrations/versions/__pycache__/
