# ===========================================================================
# ULTRON - example environment file
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values. NEVER commit `.env`
# (spec section 31). Every value below is a placeholder.
#
#   cp .env.example .env
#
# Values are read by ULTRON Server; on Windows and Linux alike, so no
# Windows-only paths here (spec section 36).
# ===========================================================================

# ---------------------------------------------------------------------------
# Core application
# ---------------------------------------------------------------------------
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                   # json | console
LOG_FILE=                         # optional path; empty = stdout only
APP_NAME=ULTRON
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1                     # >1 requires Redis coordination (spec section 24)
API_RELOAD=false
API_ROOT_PATH=                    # set when served behind a reverse proxy subpath
DEBUG=false

# Trusted origins for CORS. Comma separated. Empty = disabled.
CORS_ORIGINS=

# Seconds to wait for graceful shutdown before forcing exit.
SHUTDOWN_TIMEOUT=30

# ---------------------------------------------------------------------------
# Authentication / security (spec sections 30, 31)
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_generate_a_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Bootstrap administrator, created on first migration if no user exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# Argon2 password hashing cost factors.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Allow the WebSocket and REST API without a token. Development ONLY.
# Must be false in production.
ALLOW_ANONYMOUS=false

# Rate limiting (requests per minute per principal).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120

# ---------------------------------------------------------------------------
# PostgreSQL (authoritative source of truth, spec sections 23, 24)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://ultron:CHANGE_ME@localhost:5432/ultron
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false
# Run Alembic migrations automatically on startup. Keep false in production
# and run them as an explicit deployment step instead.
DATABASE_AUTO_MIGRATE=false
# Enable the pgvector extension during migrations (spec section 22).
ENABLE_PGVECTOR=true

# ---------------------------------------------------------------------------
# Redis (temporary state, queues, pub/sub, locks, cache - never the source of
# truth, spec section 24)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
# Default TTL, seconds, for short-lived keys.
REDIS_DEFAULT_TTL=3600
# Mirror internal bus events to Redis pub/sub for multi-process fan-out.
REDIS_EVENT_BRIDGE=false

# ---------------------------------------------------------------------------
# Ollama (model provider, spec section 21)
# ---------------------------------------------------------------------------
# Do not assume localhost in production. A hosted Ollama speaks the same HTTP
# API as a local one, so this URL is the only difference between the two.
OLLAMA_URL=http://localhost:11434
# Bearer token for a hosted Ollama. Leave empty for a local instance, which
# needs no credential; a hosted one returns 401 without a valid key.
OLLAMA_API_KEY=
OLLAMA_TIMEOUT=120
# Budget for a health probe. Deliberately much shorter than OLLAMA_TIMEOUT:
# a health check answers "is it there", not "is a generation fast".
OLLAMA_CONNECT_TIMEOUT=10
OLLAMA_KEEPALIVE=5m
OLLAMA_NUM_CTX=4096
# Optional: only offer these models to the router. Empty = discover all.
OLLAMA_MODELS=
# Embedding model used by semantic memory (spec section 22).
OLLAMA_EMBEDDING_MODEL=
# Report Ollama health through /health and /ready.
OLLAMA_HEALTHCHECK=true

# ---------------------------------------------------------------------------
# Cloud model providers (optional, spec section 3)
# Leave blank to disable a provider. The server must boot with all of these
# empty and must function with only Ollama configured.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=60

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT=60

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_TIMEOUT=60

# ---------------------------------------------------------------------------
# Model router (spec sections 20, 49)
# Format: <provider>:<model>   e.g. ollama:qwen2.5-coder:7b
# No model name is hard-coded in the application; all selection is config.
# ---------------------------------------------------------------------------
MODEL_DEFAULT=ollama:qwen2.5:7b-instruct
MODEL_CODING=
MODEL_RESEARCH=
MODEL_VISION=
MODEL_FAST=
MODEL_REASONING=
# Ordered fallback chain used when the selected provider is unavailable.
MODEL_FALLBACK_CHAIN=
MODEL_MAX_OUTPUT_TOKENS=4096
MODEL_TEMPERATURE=0.7
MODEL_REQUEST_TIMEOUT=180
# Retry budget for transient provider errors.
MODEL_MAX_RETRIES=2
MODEL_RETRY_BACKOFF=2.0
# Record token usage and latency to the model_usage table.
MODEL_USAGE_TRACKING=true
# How often Ollama availability is re-probed, seconds.
MODEL_HEALTH_REFRESH=60

# ---------------------------------------------------------------------------
# Embeddings / semantic memory (spec section 22, phase 7)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=ollama        # ollama | openai | none
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT=30
# Deterministic offline fallback used only for local tests. NOT for production.
EMBEDDING_ALLOW_HASH_FALLBACK=false

# ---------------------------------------------------------------------------
# OpenCode coding engine (spec sections 8, 9)
# ---------------------------------------------------------------------------
# Absolute path or a name resolvable on PATH. Never expose server directories
# automatically: every coding task must be given an explicit workspace.
OPENCODE_PATH=opencode
OPENCODE_MODEL=                  # provider/model passed to the CLI
OPENCODE_PROVIDER=               # provider passed to the CLI
OPENCODE_TIMEOUT=1800            # seconds
OPENCODE_MAX_OUTPUT_LINES=5000
# Arguments always passed to the CLI invocation.
OPENCODE_EXTRA_ARGS=
# Working directory template. Placeholders: {workspace}
OPENCODE_WORKSPACE_TEMPLATE=
# Use a dedicated git worktree/branch for autonomous modifications (spec section 9).
OPENCODE_GIT_ISOLATION=true
OPENCODE_GIT_BRANCH_PREFIX=ultron

# ---------------------------------------------------------------------------
# Workspaces (spec section 46)
# ---------------------------------------------------------------------------
# Root directory that holds registered project checkouts. On Ubuntu this is
# typically /opt/ultron/workspaces.
WORKSPACES_ROOT=./workspaces
# Refuse any filesystem or git operation outside these roots.
WORKSPACES_ALLOWED_ROOTS=
WORKSPACES_CLEANUP_ON_TASK_END=false
WORKSPACES_MAX_SIZE_MB=5120

# ---------------------------------------------------------------------------
# Agents (spec sections 6, 7, 41)
# ---------------------------------------------------------------------------
AGENT_DEFAULT_TIMEOUT=900
AGENT_MAX_CONCURRENCY=4          # resource-aware scheduling (spec section 48)
AGENT_MAX_PER_TYPE=8
AGENT_HEARTBEAT_INTERVAL=15
# Default permission ceiling granted to newly created agents (spec section 15).
# 0=read 1=safe 2=project files 3=execute 4=system config 5=destructive
AGENT_DEFAULT_PERMISSION_LEVEL=1
# Require explicit human confirmation for a permission level, 0-5.
AGENT_CONFIRMATION_LEVEL=4
AGENT_MAX_LOG_LINES=2000
# Default memory namespace prefix.
AGENT_MEMORY_NAMESPACE=agent

# ---------------------------------------------------------------------------
# Tasks (spec section 18)
# ---------------------------------------------------------------------------
TASK_DEFAULT_TIMEOUT=1800
TASK_MAX_PARALLEL=8
TASK_MAX_RETRIES=1
TASK_PERSIST=true
# Recover unfinished tasks after a restart.
TASK_RECOVER_ON_STARTUP=true
TASK_MAX_STEPS=100
TASK_GRAPH_CYCLE_DETECTION=true

# ---------------------------------------------------------------------------
# Tool runtime (spec sections 14, 16)
# ---------------------------------------------------------------------------
# Command allow-list for terminal.execute. Empty = deny all shell execution.
TERMINAL_ALLOWED_COMMANDS=
TERMINAL_TIMEOUT=60
TERMINAL_MAX_OUTPUT_BYTES=1048576
# Command prefixes that are never allowed, even if allow-listed.
TERMINAL_DENIED_PATTERNS=rm -rf /,mkfs,shutdown,reboot,dd if=

# Python execution tool.
PYTHON_TIMEOUT=60
PYTHON_MEMORY_LIMIT_MB=512

# Web tools.
WEB_TIMEOUT=30
WEB_MAX_RESPONSE_BYTES=5242880
WEB_USER_AGENT=ULTRON/0.1 (+https://localhost)
# Search provider: duckduckgo | searxng | none
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_URL=                  # required for searxng
WEB_ALLOW_PRIVATE_NETWORKS=false # SSRF guard (spec section 31)

# ---------------------------------------------------------------------------
# Browser automation (spec section 11)
# ---------------------------------------------------------------------------
BROWSER_ENABLED=false
BROWSER_HEADLESS=true
BROWSER_EXECUTABLE_PATH=         # empty = bundled Playwright Chromium
BROWSER_TIMEOUT=30
BROWSER_MAX_SESSIONS=4
BROWSER_SCREENSHOT_DIR=./data/screenshots
BROWSER_DOWNLOAD_DIR=./data/downloads
# Persist cookies/state between agent sessions.
BROWSER_PERSIST_PROFILE=false
BROWSER_BLOCK_MEDIA=true

# ---------------------------------------------------------------------------
# Computer nodes (spec sections 13, 42)
# ---------------------------------------------------------------------------
COMPUTER_NODES_ENABLED=true
COMPUTER_NODE_TOKEN_TTL=3600
COMPUTER_NODE_HEARTBEAT=15
COMPUTER_NODE_OFFLINE_AFTER=45
# Capability preference order (spec section 42): application API first, then
# DOM, then UI automation, then shortcuts, then mouse, then vision.
COMPUTER_CAPABILITY_PRIORITY=application_api,dom,ui_automation,keyboard_shortcut,mouse,vision
COMPUTER_NODE_DEFAULT_PERMISSION_LEVEL=4

# ---------------------------------------------------------------------------
# Devices / ESP32 (spec section 26)
# ---------------------------------------------------------------------------
DEVICES_ENABLED=true
DEVICES_HEARTBEAT_TIMEOUT=60
DEVICES_MAX_CONNECTIONS=32
ESP32_PROTOCOL_VERSION=1
ESP32_REQUIRE_AUTH=true
# Optional MQTT transport (spec section 26).
MQTT_ENABLED=false
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=ultron
MQTT_TOPIC_PREFIX=ultron

# ---------------------------------------------------------------------------
# Voice (spec section 25)
# ---------------------------------------------------------------------------
VOICE_ENABLED=false
STT_ENGINE=none                 # none | faster-whisper
STT_MODEL=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=en
STT_TIMEOUT=60
STT_PARTIAL_RESULTS=true
TTS_ENGINE=none                 # none | piper
TTS_MODEL_PATH=                 # path to a Piper .onnx voice
TTS_BINARY_PATH=piper
TTS_SAMPLE_RATE=22050
TTS_TIMEOUT=60
# Barge-in: stop TTS playback when the user starts speaking again.
VOICE_INTERRUPTION_ENABLED=true
VOICE_SESSION_TTL=300
WAKE_WORDS=ultron,hey ultron

# ---------------------------------------------------------------------------
# Scheduler (spec section 44)
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
SCHEDULER_MAX_INSTANCES=3
SCHEDULER_MISFIRE_GRACE=300
SCHEDULER_JOB_STORE=database
SCHEDULER_MISFIRE_GRACE_SECONDS=300

# ---------------------------------------------------------------------------
# Notifications (spec section 45)
# ---------------------------------------------------------------------------
NOTIFICATION_ENABLED=true
NOTIFICATION_DEFAULT_PROVIDER=log
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TIMEOUT=15
NOTIFICATION_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Memory (spec section 22)
# ---------------------------------------------------------------------------
MEMORY_ENABLED=true
MEMORY_SHORT_TERM_MAX_MESSAGES=40
MEMORY_SHORT_TERM_TTL=86400
MEMORY_RETRIEVAL_TOP_K=8
MEMORY_MIN_SIMILARITY=0.25
MEMORY_EPISODIC_RETENTION_DAYS=180
MEMORY_LONG_TERM_ENABLED=true
MEMORY_SEMANTIC_ENABLED=true
MEMORY_DEFAULT_NAMESPACE=user

# ---------------------------------------------------------------------------
# Observability (spec section 32)
# ---------------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_INCLUDE_IN_LOG=false
# Resource thresholds that emit CPU_HIGH / RAM_HIGH / DISK_LOW / GPU_HIGH.
RESOURCE_MONITOR_ENABLED=true
RESOURCE_MONITOR_INTERVAL=30
CPU_HIGH_PERCENT=85
RAM_HIGH_PERCENT=90
DISK_LOW_PERCENT=10
GPU_HIGH_PERCENT=90
# Event persistence.
EVENTS_PERSIST=true
EVENT_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=180
HEALTHCHECK_CACHE_TTL=5
