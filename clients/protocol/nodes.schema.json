{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultron.local/protocol/nodes.schema.json",
  "title": "ULTRON Node Capabilities",
  "description": "The shared JSON Schema for /nodes API payloads (T331, spec §64.10). Both the server API and clients use this single source of truth for node capability shapes, so the Windows node, PWA, and Electron client all read the same definition.",
  "type": "object",
  "additionalProperties": false,
  "required": ["node_id", "node_type", "name", "capabilities", "status"],
  "properties": {
    "node_id": { "type": "string" },
    "node_type": { "$ref": "#/$defs/NodeType" },
    "name": { "type": "string" },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/Capability" }
    },
    "status": { "$ref": "#/$defs/NodeStatus" },
    "last_seen": {
      "anyOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "connected_at": {
      "anyOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "version": { "type": "string" },
    "client_of": {
      "anyOf": [
        { "type": "string" },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "NodeType": {
      "title": "NodeType",
      "description": "The node inventory (spec 64.5). The set is closed; `future` is the escape hatch so a new kind can register without a schema change.",
      "type": "string",
      "enum": ["windows", "server", "esp32", "future"]
    },
    "NodeStatus": {
      "title": "NodeStatus",
      "description": "Node availability (spec 64.10).",
      "type": "string",
      "enum": ["online", "offline", "degraded"]
    },
    "Capability": {
      "title": "Capability",
      "description": "The capability families a node may advertise (spec 64.6.2 Windows, 64.7 server, 64.9 ESP32). Advisory: a node may advertise a string not in this list and the registry stores it.",
      "type": "string",
      "enum": [
        "filesystem",
        "powershell",
        "windows_apps",
        "windows_ui",
        "browser",
        "git",
        "processes",
        "screenshots",
        "notifications",
        "clipboard",
        "linux_apps",
        "linux_shell",
        "server_management",
        "background_agents",
        "scheduler",
        "services",
        "display",
        "microphone",
        "speaker",
        "buttons",
        "sensors",
        "physical_controls"
      ]
    }
  }
}
